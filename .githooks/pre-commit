#!/usr/bin/env bash
# Versioned pre-commit hook. Enable once per clone:  make hooks   (git config core.hooksPath .githooks)
#
# Checks, in order (all must pass):
#   1.1 code caps  file 500 / function 50 / class 300 / params 4 / nesting 4 lines, from the AST,
#                  ratcheted against .code-caps-baseline.json (new or grown violation blocks)
#
# The sources use Python 3.14 syntax (PEP 758), so the AST check needs a 3.14 interpreter:
# python3.14 when installed, otherwise a uv-managed one. The script itself is stdlib only.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit 1.1 code caps"
if command -v python3.14 >/dev/null 2>&1; then
  python3.14 scripts/check_code_caps.py
else
  uv run --no-project --python 3.14 python scripts/check_code_caps.py
fi
