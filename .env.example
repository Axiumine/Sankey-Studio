# Copy to .env (gitignored). Loaded only by scripts/qodana.sh; the app itself reads SANKEY_* env vars.
# Qodana Cloud token for the Ultimate Plus licence (https://qodana.cloud -> project -> token).
QODANA_TOKEN=

